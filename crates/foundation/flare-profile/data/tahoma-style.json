{
  "schema": 1,
  "id": "tahoma-style",
  "title": "Tahoma-style",
  "shortcut_set": "opentoonz",
  "theme": "light",
  "toolbars": [
    {
      "id": "tools",
      "visible": true
    },
    {
      "id": "top-bar",
      "visible": true
    },
    {
      "id": "playback",
      "visible": true
    }
  ],
  "rooms": [
    {
      "id": "main",
      "title": "Main",
      "layout": {
        "kind": "split",
        "axis": "vertical",
        "first_fraction": 0.5,
        "first": {
          "kind": "split",
          "axis": "horizontal",
          "first_fraction": 0.3333,
          "first": {
            "kind": "stack",
            "panels": [
              "tools"
            ],
            "active": 0
          },
          "second": {
            "kind": "split",
            "axis": "horizontal",
            "first_fraction": 0.5,
            "first": {
              "kind": "stack",
              "panels": [
                "tool_options"
              ],
              "active": 0
            },
            "second": {
              "kind": "stack",
              "panels": [
                "properties",
                "library",
                "color"
              ],
              "active": 0
            }
          }
        },
        "second": {
          "kind": "split",
          "axis": "horizontal",
          "first_fraction": 0.3333,
          "first": {
            "kind": "stack",
            "panels": [
              "xsheet"
            ],
            "active": 0
          },
          "second": {
            "kind": "split",
            "axis": "horizontal",
            "first_fraction": 0.5,
            "first": {
              "kind": "stack",
              "panels": [
                "timeline",
                "output"
              ],
              "active": 0
            },
            "second": {
              "kind": "stack",
              "panels": [
                "level_strip",
                "level_palette",
                "style_editor"
              ],
              "active": 0
            }
          }
        }
      }
    },
    {
      "id": "fx",
      "title": "Effects",
      "layout": {
        "kind": "split",
        "axis": "horizontal",
        "first_fraction": 0.3333,
        "first": {
          "kind": "stack",
          "panels": [
            "schematic",
            "function_editor"
          ],
          "active": 0
        },
        "second": {
          "kind": "split",
          "axis": "horizontal",
          "first_fraction": 0.5,
          "first": {
            "kind": "stack",
            "panels": [
              "fx_browser",
              "fx_settings",
              "motion_path"
            ],
            "active": 0
          },
          "second": {
            "kind": "stack",
            "panels": [
              "align",
              "transform",
              "history",
              "info"
            ],
            "active": 0
          }
        }
      }
    },
    {
      "id": "tools",
      "title": "Tools",
      "layout": {
        "kind": "split",
        "axis": "horizontal",
        "first_fraction": 0.3333,
        "first": {
          "kind": "stack",
          "panels": [
            "cleanup",
            "cleanup_settings",
            "scan"
          ],
          "active": 0
        },
        "second": {
          "kind": "split",
          "axis": "horizontal",
          "first_fraction": 0.5,
          "first": {
            "kind": "stack",
            "panels": [
              "plastic",
              "scene_cast",
              "browser"
            ],
            "active": 0
          },
          "second": {
            "kind": "stack",
            "panels": [
              "script_console",
              "tasks"
            ],
            "active": 0
          }
        }
      }
    }
  ],
  "default_room": 0
}

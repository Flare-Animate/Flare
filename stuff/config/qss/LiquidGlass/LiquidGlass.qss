/* Liquid Glass is Flare's default interface theme. The original Default theme
   remains selectable in Preferences for users who prefer the classic look.

   This file used to be a 33-line fragment covering only common widgets, so
   picking it left the rest of the UI unstyled. Every theme in this directory
   covers the same 715 selectors; rather than hand-maintaining another 3350-line
   copy, Liquid Glass now layers its palette and shape overrides on top of a
   complete base theme. The path below is rewritten to an absolute one by
   Preferences::getCurrentStyleSheet(), so it resolves regardless of the
   process working directory. */
@import "../Dark/Dark.qss";
:TOONZCOLORS {
  -bg-color: #1a2332; -icon-base-opacity: 0.92; -icon-disabled-opacity: 0.35;
  -icon-base-color: #e0ecf5; -icon-active-color: #ffffff; -icon-selected-color: #ffffff;
  -icon-on-color: #ffffff; -icon-close-color: #ffffff; -icon-preview-color: #0e1520;
  -icon-vcheck-color: #ffffff; -icon-lock-color: #ffffff; -icon-keyframe-color: #5ac8fa;
  -icon-keyframe-modified-color: #ff9f0a;
}
/* Liquid Glass: translucent layered surfaces with depth and vibrancy */
QWidget { background-color: #1a2332; color: #e8f0f8; }
QWidget:disabled { color: rgba(232, 240, 248, 0.38); }
QToolTip, #helpToolTip { background-color: rgba(30, 42, 58, 0.92); border: 1 solid rgba(93, 120, 149, 0.6); border-radius: 8px; color: #f5fbff; padding: 6px 10px; }
TPanel, QDockWidget { background-color: rgba(36, 50, 70, 0.85); border: 1 solid rgba(64, 88, 115, 0.5); border-radius: 10px; }
#DockSeparator, QMainWindow::separator, QSplitter::handle { background-color: rgba(51, 72, 97, 0.6); height: 4px; width: 4px; }
#TopBar, #TopBarTabContainer, QMenuBar { background-color: rgba(24, 34, 48, 0.9); border-bottom: 1 solid rgba(80, 107, 135, 0.5); }
QMenuBar::item { background: transparent; padding: 4px 8px; border-radius: 6px; }
QMenuBar::item:selected { background-color: rgba(50, 73, 99, 0.7); border-radius: 6px; color: #ffffff; }
QMenu, QComboBox QAbstractItemView { background-color: rgba(35, 50, 70, 0.92); border: 1 solid rgba(93, 120, 149, 0.5); border-radius: 10px; padding: 4px; }
QMenu::item { padding: 6px 28px 6px 14px; border-radius: 6px; }
QMenu::item:selected, QComboBox QAbstractItemView::item:selected { background-color: rgba(60, 136, 173, 0.8); color: #ffffff; border-radius: 6px; }
#TopBarTab::tab { background-color: rgba(34, 48, 66, 0.7); border: 1 solid rgba(72, 98, 125, 0.5); border-bottom: 0; border-radius: 8px 8px 0 0; margin: 2px 2px 0 0; padding: 5px 12px; }
#TopBarTab::tab:hover { background-color: rgba(48, 72, 96, 0.8); }
#TopBarTab::tab:selected { background-color: rgba(60, 136, 173, 0.85); border-color: rgba(116, 216, 255, 0.6); color: #ffffff; border-radius: 8px 8px 0 0; }
QPushButton, QToolButton, QComboBox, QLineEdit, QSpinBox { background-color: rgba(40, 56, 76, 0.75); border: 1 solid rgba(88, 116, 145, 0.5); border-radius: 8px; color: #eaf5ff; min-height: 22px; padding: 3px 8px; }
QPushButton:hover, QToolButton:hover, QComboBox:hover { background-color: rgba(52, 76, 102, 0.85); border-color: rgba(134, 212, 243, 0.6); }
QPushButton:pressed, QToolButton:pressed, QToolButton:checked { background-color: rgba(51, 126, 165, 0.85); border-color: rgba(159, 232, 255, 0.7); }
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border: 1 solid rgba(116, 216, 255, 0.7); background-color: rgba(44, 64, 88, 0.85); }
QTabBar::tab { background-color: rgba(36, 50, 70, 0.7); border: 1 solid rgba(76, 102, 129, 0.5); border-radius: 8px 8px 0 0; padding: 5px 10px; }
QTabBar::tab:selected { background-color: rgba(57, 127, 165, 0.85); color: #ffffff; border-radius: 8px 8px 0 0; }
QScrollBar:vertical, QScrollBar:horizontal { background: rgba(22, 34, 48, 0.6); margin: 0; border-radius: 4px; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: rgba(83, 113, 141, 0.7); border-radius: 4px; min-height: 20px; min-width: 20px; }
QScrollBar::handle:hover { background: rgba(119, 185, 217, 0.85); }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
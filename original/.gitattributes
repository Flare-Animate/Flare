*.lib filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text

# Ensure .bat files use CRLF line endings
*.bat text eol=crlf

# Differential goldens are byte-sensitive: the Rust tests `include_str!` them and
# `tests/run_stdfx_goldens.py` fails on a single differing byte. A CRLF checkout on
# Windows would break both, so never convert these.
flare/sources/stdfx/*_cases*.txt -text

# Ensure consistent line endings for test manifests
tests/*.json text eol=lf

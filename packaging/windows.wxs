<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Flare" Manufacturer="Flare" Version="$(var.Version)"
           Scope="perUser" UpgradeCode="6f1a7c52-3d9e-4b0a-9c64-0e2b7a58d1f3">
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer Flare version is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="FlareIcon" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="FlareIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Flare-Animate/Flare" />
    <!-- Installed for the current user, so no administrator prompt: in a per-user install the Program
         Files folder is the user's own (under LocalAppData\Programs) and HKMU is HKCU, which is where
         the file types are registered. -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Flare">
        <Component Id="Application" Guid="*" Bitness="always64">
          <File Id="FlareExe" Source="$(var.Binary)" Name="flare-desktop.exe" KeyPath="yes">
            <Shortcut Id="LaunchFlare" Name="Flare" Directory="ProgramMenuFolder"
                      Advertise="yes" WorkingDirectory="INSTALLFOLDER" Icon="FlareIcon" />
          </File>
        </Component>
        <!-- One file per component: WiX can only make a component's identity itself when it
             holds a single file or a versioned one, and these are plain text. -->
        <Component Id="LicenseText" Guid="*" Bitness="always64">
          <File Id="License" Source="$(var.License)" Name="LICENSE.txt" KeyPath="yes" />
        </Component>
        <Component Id="FontLicenseText" Guid="*" Bitness="always64">
          <File Id="FontLicense" Source="$(var.FontLicense)" Name="OFL.txt" KeyPath="yes" />
        </Component>
        <Component Id="FlareAssociation" Guid="*" Bitness="always64">
          <RegistryValue Root="HKMU" Key="Software\Classes\Flare.Project" Type="string"
                         Value="Flare Project" KeyPath="yes" />
          <RegistryValue Root="HKMU" Key="Software\Classes\Flare.Project\DefaultIcon"
                         Type="string" Value="&quot;[#FlareExe]&quot;,0" />
          <RegistryValue Root="HKMU" Key="Software\Classes\Flare.Project\shell\open\command"
                         Type="string" Value="&quot;[#FlareExe]&quot; &quot;%1&quot;" />
          <RegistryValue Root="HKMU" Key="Software\Classes\.flare" Type="string" Value="Flare.Project" />
          <RegistryValue Root="HKMU" Key="Software\Classes\.flare" Name="Content Type"
                         Type="string" Value="application/x-flare" />
          <RegistryValue Root="HKMU" Key="Software\Classes\.flare\OpenWithProgids"
                         Name="Flare.Project" Type="string" Value="" />
          <!-- Animate's formats are offered under "Open with" and in Default apps, never made the
               default. -->
          <RegistryValue Root="HKMU" Key="Software\Classes\Flare.Animate" Type="string"
                         Value="Animate Document" />
          <RegistryValue Root="HKMU" Key="Software\Classes\Flare.Animate\DefaultIcon"
                         Type="string" Value="&quot;[#FlareExe]&quot;,0" />
          <RegistryValue Root="HKMU" Key="Software\Classes\Flare.Animate\shell\open\command"
                         Type="string" Value="&quot;[#FlareExe]&quot; &quot;%1&quot;" />
          <RegistryValue Root="HKMU" Key="Software\Classes\.fla\OpenWithProgids"
                         Name="Flare.Animate" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\.xfl\OpenWithProgids"
                         Name="Flare.Animate" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\.swf\OpenWithProgids"
                         Name="Flare.Animate" Type="string" Value="" />
          <!-- The other projects Flare imports are offered the same way, never made the default.
               There is no default key for them here on purpose; only .flare's is a default. -->
          <RegistryValue Root="HKMU" Key="Software\Classes\.fcp\OpenWithProgids"
                         Name="Flare.Animate" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\.ppm\OpenWithProgids"
                         Name="Flare.Animate" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\.kwz\OpenWithProgids"
                         Name="Flare.Animate" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\.tnz\OpenWithProgids"
                         Name="Flare.Animate" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\.tlv\OpenWithProgids"
                         Name="Flare.Animate" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\.pli\OpenWithProgids"
                         Name="Flare.Animate" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\.tzu\OpenWithProgids"
                         Name="Flare.Animate" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\.moho\OpenWithProgids"
                         Name="Flare.Animate" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\.mh\OpenWithProgids"
                         Name="Flare.Animate" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\.mohobackup\OpenWithProgids"
                         Name="Flare.Animate" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\Applications\flare-desktop.exe"
                         Name="FriendlyAppName" Type="string" Value="Flare" />
          <RegistryValue Root="HKMU" Key="Software\Classes\Applications\flare-desktop.exe\SupportedTypes"
                         Name=".flare" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\Applications\flare-desktop.exe\SupportedTypes"
                         Name=".fla" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\Applications\flare-desktop.exe\SupportedTypes"
                         Name=".xfl" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\Applications\flare-desktop.exe\SupportedTypes"
                         Name=".swf" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\Applications\flare-desktop.exe\SupportedTypes"
                         Name=".fcp" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\Applications\flare-desktop.exe\SupportedTypes"
                         Name=".ppm" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\Applications\flare-desktop.exe\SupportedTypes"
                         Name=".kwz" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\Applications\flare-desktop.exe\SupportedTypes"
                         Name=".tnz" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\Applications\flare-desktop.exe\SupportedTypes"
                         Name=".tlv" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\Applications\flare-desktop.exe\SupportedTypes"
                         Name=".pli" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\Applications\flare-desktop.exe\SupportedTypes"
                         Name=".tzu" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\Applications\flare-desktop.exe\SupportedTypes"
                         Name=".moho" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\Applications\flare-desktop.exe\SupportedTypes"
                         Name=".mh" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\Applications\flare-desktop.exe\SupportedTypes"
                         Name=".mohobackup" Type="string" Value="" />
          <RegistryValue Root="HKMU" Key="Software\Classes\Applications\flare-desktop.exe\shell\open\command"
                         Type="string" Value="&quot;[#FlareExe]&quot; &quot;%1&quot;" />
          <RegistryValue Root="HKMU" Key="Software\Flare\Capabilities"
                         Name="ApplicationName" Type="string" Value="Flare" />
          <RegistryValue Root="HKMU" Key="Software\Flare\Capabilities"
                         Name="ApplicationDescription" Type="string" Value="Flare animation tool" />
          <RegistryValue Root="HKMU" Key="Software\Flare\Capabilities\FileAssociations"
                         Name=".flare" Type="string" Value="Flare.Project" />
          <RegistryValue Root="HKMU" Key="Software\Flare\Capabilities\FileAssociations"
                         Name=".fla" Type="string" Value="Flare.Animate" />
          <RegistryValue Root="HKMU" Key="Software\Flare\Capabilities\FileAssociations"
                         Name=".xfl" Type="string" Value="Flare.Animate" />
          <RegistryValue Root="HKMU" Key="Software\Flare\Capabilities\FileAssociations"
                         Name=".swf" Type="string" Value="Flare.Animate" />
          <RegistryValue Root="HKMU" Key="Software\Flare\Capabilities\FileAssociations"
                         Name=".fcp" Type="string" Value="Flare.Animate" />
          <RegistryValue Root="HKMU" Key="Software\Flare\Capabilities\FileAssociations"
                         Name=".ppm" Type="string" Value="Flare.Animate" />
          <RegistryValue Root="HKMU" Key="Software\Flare\Capabilities\FileAssociations"
                         Name=".kwz" Type="string" Value="Flare.Animate" />
          <RegistryValue Root="HKMU" Key="Software\Flare\Capabilities\FileAssociations"
                         Name=".tnz" Type="string" Value="Flare.Animate" />
          <RegistryValue Root="HKMU" Key="Software\Flare\Capabilities\FileAssociations"
                         Name=".tlv" Type="string" Value="Flare.Animate" />
          <RegistryValue Root="HKMU" Key="Software\Flare\Capabilities\FileAssociations"
                         Name=".pli" Type="string" Value="Flare.Animate" />
          <RegistryValue Root="HKMU" Key="Software\Flare\Capabilities\FileAssociations"
                         Name=".tzu" Type="string" Value="Flare.Animate" />
          <RegistryValue Root="HKMU" Key="Software\Flare\Capabilities\FileAssociations"
                         Name=".moho" Type="string" Value="Flare.Animate" />
          <RegistryValue Root="HKMU" Key="Software\Flare\Capabilities\FileAssociations"
                         Name=".mh" Type="string" Value="Flare.Animate" />
          <RegistryValue Root="HKMU" Key="Software\Flare\Capabilities\FileAssociations"
                         Name=".mohobackup" Type="string" Value="Flare.Animate" />
          <RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="Flare"
                         Type="string" Value="Software\Flare\Capabilities" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <Feature Id="MainFeature" Title="Flare" Level="1">
      <ComponentRef Id="Application" />
      <ComponentRef Id="LicenseText" />
      <ComponentRef Id="FontLicenseText" />
      <ComponentRef Id="FlareAssociation" />
    </Feature>
  </Package>
</Wix>

<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-flare">
    <comment>Flare Project</comment>
    <glob pattern="*.flare" />
    <icon name="flare" />
  </mime-type>
  <!-- Animate's formats, which Flare imports. They are declared so Flare can be offered for
       them; Flare does not make itself their default. -->
  <mime-type type="application/x-flare-fla">
    <comment>Animate Document</comment>
    <sub-class-of type="application/zip" />
    <glob pattern="*.fla" />
  </mime-type>
  <mime-type type="application/x-flare-xfl">
    <comment>Animate Document (XFL)</comment>
    <sub-class-of type="application/xml" />
    <glob pattern="*.xfl" />
  </mime-type>
  <!-- Flash movies, which Flare imports. The type is the system's own; declaring it here only
       lets Flare be offered for it. -->
  <mime-type type="application/x-shockwave-flash">
    <comment>Flash Movie</comment>
    <glob pattern="*.swf" />
  </mime-type>
  <mime-type type="application/x-flare-bvh">
    <comment>BVH Motion</comment>
    <glob pattern="*.bvh" />
  </mime-type>
  <!-- The image files Flare imports as bitmap layers (docs/ARCHITECTURE.md). PNG, JPEG, GIF and SVG
       are the systems' own types; declaring them here only lets Flare be offered for them, and
       Flare does not make itself their default either. -->
  <mime-type type="image/png">
    <comment>PNG Image</comment>
    <glob pattern="*.png" />
  </mime-type>
  <mime-type type="image/jpeg">
    <comment>JPEG Image</comment>
    <glob pattern="*.jpg" />
    <glob pattern="*.jpeg" />
  </mime-type>
  <mime-type type="image/bmp">
    <comment>Bitmap Image</comment>
    <glob pattern="*.bmp" />
  </mime-type>
  <mime-type type="image/x-tga">
    <comment>TGA Image</comment>
    <glob pattern="*.tga" />
  </mime-type>
  <mime-type type="image/tiff">
    <comment>image/tiff image</comment>
    <glob pattern="*.tif" />
    <glob pattern="*.tiff" />
  </mime-type>
  <mime-type type="image/vnd.microsoft.icon">
    <comment>image/vnd.microsoft.icon image</comment>
    <glob pattern="*.ico" />
  </mime-type>
  <mime-type type="image/vnd.ms-dds">
    <comment>image/vnd.ms-dds image</comment>
    <glob pattern="*.dds" />
  </mime-type>
  <mime-type type="image/vnd.radiance">
    <comment>image/vnd.radiance image</comment>
    <glob pattern="*.hdr" />
  </mime-type>
  <mime-type type="image/webp">
    <comment>image/webp image</comment>
    <glob pattern="*.webp" />
  </mime-type>
  <mime-type type="image/x-exr">
    <comment>image/x-exr image</comment>
    <glob pattern="*.exr" />
  </mime-type>
  <mime-type type="image/x-portable-anymap">
    <comment>image/x-portable-anymap image</comment>
    <glob pattern="*.pnm" />
  </mime-type>
  <mime-type type="image/x-portable-arbitrarymap">
    <comment>image/x-portable-arbitrarymap image</comment>
    <glob pattern="*.pam" />
  </mime-type>
  <mime-type type="image/x-portable-bitmap">
    <comment>image/x-portable-bitmap image</comment>
    <glob pattern="*.pbm" />
  </mime-type>
  <mime-type type="image/x-portable-graymap">
    <comment>image/x-portable-graymap image</comment>
    <glob pattern="*.pgm" />
  </mime-type>
  <mime-type type="image/x-qoi">
    <comment>image/x-qoi image</comment>
    <glob pattern="*.qoi" />
  </mime-type>
  <mime-type type="image/vnd.adobe.photoshop">
    <comment>Photoshop Image</comment>
    <glob pattern="*.psd" />
  </mime-type>
  <mime-type type="video/mp4">
    <comment>video/mp4 movie</comment>
    <glob pattern="*.mp4" />
  </mime-type>
  <mime-type type="video/mpeg">
    <comment>video/mpeg movie</comment>
    <glob pattern="*.mpeg" />
    <glob pattern="*.mpg" />
  </mime-type>
  <mime-type type="video/quicktime">
    <comment>video/quicktime movie</comment>
    <glob pattern="*.mov" />
  </mime-type>
  <mime-type type="video/webm">
    <comment>video/webm movie</comment>
    <glob pattern="*.webm" />
  </mime-type>
  <mime-type type="video/x-flv">
    <comment>video/x-flv movie</comment>
    <glob pattern="*.flv" />
  </mime-type>
  <mime-type type="video/x-matroska">
    <comment>video/x-matroska movie</comment>
    <glob pattern="*.mkv" />
  </mime-type>
  <mime-type type="video/x-msvideo">
    <comment>video/x-msvideo movie</comment>
    <glob pattern="*.avi" />
  </mime-type>
  <mime-type type="image/gif">
    <comment>GIF Image</comment>
    <glob pattern="*.gif" />
  </mime-type>
  <mime-type type="image/svg+xml">
    <comment>SVG Image</comment>
    <sub-class-of type="application/xml" />
    <glob pattern="*.svg" />
  </mime-type>
  <!-- The other projects Flare imports, none of which the systems name, so each is declared
       here; Flare does not make itself their default either. The import of them is a report,
       not a promise (docs/ARCHITECTURE.md). -->
  <mime-type type="application/x-flare-fcp">
    <comment>FlipaClip Project</comment>
    <glob pattern="*.fc" />
  </mime-type>
  <mime-type type="application/x-flare-wick">
    <comment>Wick Editor Project</comment>
    <glob pattern="*.wick" />
  </mime-type>
  <mime-type type="application/x-flare-ppm">
    <comment>Flipnote Studio Animation</comment>
    <glob pattern="*.ppm" />
  </mime-type>
  <mime-type type="application/x-flare-kwz">
    <comment>Flipnote Studio 3D Animation</comment>
    <glob pattern="*.kwz" />
  </mime-type>
  <mime-type type="application/x-flare-tnz">
    <comment>OpenToonz Scene</comment>
    <glob pattern="*.tnz" />
    <glob pattern="*.tpl" />
    <glob pattern="*.plt" />
  </mime-type>
  <mime-type type="application/x-flare-tlv">
    <comment>OpenToonz Level</comment>
    <glob pattern="*.tlv" />
  </mime-type>
  <mime-type type="application/x-flare-pli">
    <comment>OpenToonz Data</comment>
    <glob pattern="*.pli" />
  </mime-type>
  <mime-type type="application/x-flare-moho">
    <comment>Moho Project</comment>
    <glob pattern="*.moho" />
    <glob pattern="*.anime" />
    <glob pattern="*.mohoproj" />
    <glob pattern="*.animeproj" />
    <glob pattern="*.anme" />
  </mime-type>
</mime-info>

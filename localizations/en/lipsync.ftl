lipsync-done-built-in =
    { $n ->
        [one] Lip synced with the built-in analysis: { $n } keyframe.
       *[other] Lip synced with the built-in analysis: { $n } keyframes.
    }
lipsync-done-rhubarb =
    { $n ->
        [one] Lip synced with Rhubarb Lip Sync: { $n } keyframe.
       *[other] Lip synced with Rhubarb Lip Sync: { $n } keyframes.
    }

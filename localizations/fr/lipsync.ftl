lipsync-title = Synchronisation labiale
lipsync-sound = Son
lipsync-no-sound = Placez un son dans le scénario pour y synchroniser la bouche.
lipsync-analysis = Analyse
lipsync-auto = Automatique
lipsync-auto-tip = Rhubarb Lip Sync s’il est installé, sinon l’analyse intégrée.
lipsync-built-in = Intégrée
lipsync-rhubarb = Rhubarb Lip Sync
lipsync-rhubarb-web = Un navigateur ne peut pas exécuter Rhubarb Lip Sync ; l’analyse intégrée est utilisée.
lipsync-shapes = Formes de bouche
lipsync-shapes-tip = L’image de ce symbole qui montre chaque forme de bouche.
lipsync-neutral = Neutre
lipsync-etc = Autres consonnes
lipsync-sync = Synchroniser avec le son
lipsync-working = Lecture de la voix…
lipsync-changed = Le document a changé pendant la lecture de la voix ; synchronisez à nouveau.
lipsync-failed = Synchronisation impossible : { $reason }
lipsync-fell-back = Rhubarb Lip Sync n’a pas pu être utilisé ({ $reason }), l’analyse intégrée l’a été à sa place.
lipsync-done-built-in =
    { $n ->
        [one] Synchronisé avec l’analyse intégrée : { $n } image-clé.
       *[other] Synchronisé avec l’analyse intégrée : { $n } images-clés.
    }
lipsync-done-rhubarb =
    { $n ->
        [one] Synchronisé avec Rhubarb Lip Sync : { $n } image-clé.
       *[other] Synchronisé avec Rhubarb Lip Sync : { $n } images-clés.
    }

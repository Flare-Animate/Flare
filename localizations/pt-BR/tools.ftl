tools-bone-release = Desfazer esqueleto
tools-bone-add = Adicionar osso
tools-bone-pose = Pose do esqueleto
tools-bone-error = Não é possível fazer isso com ossos: { $error }
tools-bone-drop-on-instance = Um osso termina em uma instância de símbolo: solte sobre uma

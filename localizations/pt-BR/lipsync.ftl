lipsync-title = Sincronização labial
lipsync-sound = Som
lipsync-no-sound = Coloque um som na linha do tempo para sincronizar a boca com ele.
lipsync-analysis = Análise
lipsync-auto = Automática
lipsync-auto-tip = Rhubarb Lip Sync quando instalado; caso contrário, a análise integrada.
lipsync-built-in = Integrada
lipsync-rhubarb = Rhubarb Lip Sync
lipsync-rhubarb-web = Um navegador não pode executar o Rhubarb Lip Sync; a análise integrada é usada.
lipsync-shapes = Formas da boca
lipsync-shapes-tip = O quadro deste símbolo que mostra cada forma da boca.
lipsync-neutral = Neutra
lipsync-etc = Outras consoantes
lipsync-sync = Sincronizar com o som
lipsync-working = Lendo a voz…
lipsync-changed = O documento mudou enquanto a voz era lida; sincronize de novo.
lipsync-failed = Não foi possível sincronizar: { $reason }
lipsync-fell-back = Não foi possível usar o Rhubarb Lip Sync ({ $reason }), então foi usada a análise integrada.
lipsync-done-built-in =
    { $n ->
        [one] Sincronizado com a análise integrada: { $n } quadro-chave.
       *[other] Sincronizado com a análise integrada: { $n } quadros-chave.
    }
lipsync-done-rhubarb =
    { $n ->
        [one] Sincronizado com o Rhubarb Lip Sync: { $n } quadro-chave.
       *[other] Sincronizado com o Rhubarb Lip Sync: { $n } quadros-chave.
    }

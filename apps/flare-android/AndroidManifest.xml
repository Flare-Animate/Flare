<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android app around `libflare_android.so`: one activity, Android's own NativeActivity,
  which loads the named library and hands it the screen, so the app needs no Java of its own
  and no designer's assets. hand-written and small (see apps/flare-android/README.md); the
  package and the SDK floors are those of the app this one replaces.

  The table `[package.metadata.android]` in Cargo.toml is what `cargo apk` packages; keep the two
  in step.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.flareanimate.flare"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="34" />

    <!-- Nothing here is required: a Chromebook has no touch screen or a camera on some models, a
         tablet has no keyboard, a phone no mouse. Resizable, so ChromeOS can window it. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.keyboard" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <application
        android:allowBackup="true"
        android:label="Flare"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:label="Flare"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|density|keyboard|navigation">
            <meta-data
                android:name="android.app.lib_name"
                android:value="flare_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
